  {
    "id": "auth",
    "type": "function",
    "z": "flow_api",
    "name": "Cek API Key (X-API-Key)",
    "func": "const KEY = env.get('API_KEY') || 'iot-kampus-2026';\nmsg.route = msg.req.method + ' ' + msg.req.path;\nif (msg.req.headers['x-api-key'] !== KEY) {\n  msg.statusCode = 401;\n  msg.headers={'Access-Control-Allow-Origin':'*'};\n  msg.payload = {status: 'error', message: 'API key tidak valid / tidak ada (header X-API-Key)'};\n  return [null, msg];\n}\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "x": 400,
    "y": 400,
    "wires": [
      [
        "router"
      ],
      [
        "http_resp"
      ]
    ]
  },
  {
    "id": "router",
    "type": "switch",
    "z": "flow_api",
    "name": "Router Endpoint",
    "property": "route",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "GET /api/suhu",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "GET /api/history",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "POST /api/kontrol",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "PUT /api/threshold",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "GET /api/threshold",
        "vt": "str"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 5,
    "x": 620,
    "y": 400,
    "wires": [
      [
        "r_suhu"
      ],
      [
        "q_hist"
      ],
      [
        "r_kontrol"
      ],
      [
        "r_th_put"
      ],
      [
        "r_th_get"
      ]
    ]
  },
  {
    "id": "r_suhu",
    "type": "function",
    "z": "flow_api",
    "name": "Response Suhu",
    "func": "const d = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', data: d, threshold: flow.get('threshold'), server_time: new Date().toISOString()};\nmsg.headers={'Access-Control-Allow-Origin':'*'};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 860,
    "y": 300,
    "wires": [
      [
        "http_resp"
      ]
    ]
  },
  {
    "id": "q_hist",
    "type": "sqlite",
    "z": "flow_api",
    "mydb": "sqlite_db",
    "sqlquery": "fixed",
    "sql": "SELECT * FROM (SELECT * FROM sensor_history ORDER BY id DESC LIMIT 50) ORDER BY id ASC;",
    "name": "Query 50 Terakhir",
    "x": 860,
    "y": 350,
    "wires": [
      [
        "r_hist"
      ]
    ]
  },
  {
    "id": "r_hist",
    "type": "function",
    "z": "flow_api",
    "name": "Response History",
    "func": "const rows = msg.payload || [];\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', count: rows.length, data: rows};\nmsg.headers={'Access-Control-Allow-Origin':'*'};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 1080,
    "y": 350,
    "wires": [
      [
        "http_resp"
      ]
    ]
  },
  {
    "id": "r_kontrol",
    "type": "function",
    "z": "flow_api",
    "name": "Validasi & Publish Kontrol",
    "func": "const body = msg.payload || {};\nmsg.headers={'Access-Control-Allow-Origin':'*'};\nif (!body.device || !body.action) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n  return [msg, null];\n}\nnode.send([null, {topic: 'iot/kontrol', payload: body}]);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: body};\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "x": 880,
    "y": 400,
    "wires": [
      [
        "http_resp"
      ],
      [
        "mqtt_out"
      ]
    ]
  },
  {
    "id": "r_th_put",
    "type": "function",
    "z": "flow_api",
    "name": "Set Threshold",
    "func": "const t = Number(msg.payload && msg.payload.threshold);\nmsg.headers={'Access-Control-Allow-Origin':'*'};\nif (!isFinite(t)) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'threshold wajib berupa angka'};\n  return [msg, null];\n}\nflow.set('threshold', t);\nflow.set('lastAlert', 0);\nnode.send([null, {payload: {type: 'threshold', threshold: t}}]);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diperbarui', threshold: t};\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "x": 880,
    "y": 450,
    "wires": [
      [
        "http_resp"
      ],
      [
        "ws_out"
      ]
    ]
  },
  {
    "id": "r_th_get",
    "type": "function",
    "z": "flow_api",
    "name": "Get Threshold",
    "func": "msg.statusCode = 200;\nmsg.payload = {status: 'success', threshold: flow.get('threshold')};\nmsg.headers={'Access-Control-Allow-Origin':'*'};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 880,
    "y": 500,
    "wires": [
      [
        "http_resp"
      ]
    ]
  },
