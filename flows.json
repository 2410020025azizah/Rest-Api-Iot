[
  {
    "id": "flow_api",
    "type": "tab",
    "label": "IoT REST API",
    "disabled": false,
    "info": ""
  },
  {
    "id": "mqtt_broker_config",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-backend",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "ws_listener",
    "type": "websocket-listener",
    "path": "/ws/sensor",
    "wholemsg": "false"
  },
  {
    "id": "sqlite_db",
    "type": "sqlitedb",
    "db": "iot_history.db",
    "mode": "RWC"
  },
  {
    "id": "init_inject",
    "type": "inject",
    "z": "flow_api",
    "name": "Init (sekali)",
    "props": [],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "x": 150,
    "y": 40,
    "wires": [
      [
        "init_fn"
      ]
    ]
  },
  {
    "id": "init_fn",
    "type": "function",
    "z": "flow_api",
    "name": "Set Threshold Default",
    "func": "if (flow.get('threshold') === undefined) flow.set('threshold', 30);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 360,
    "y": 40,
    "wires": [
      [
        "create_table"
      ]
    ]
  },
  {
    "id": "create_table",
    "type": "sqlite",
    "z": "flow_api",
    "mydb": "sqlite_db",
    "sqlquery": "fixed",
    "sql": "CREATE TABLE IF NOT EXISTS sensor_history (id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL, kelembaban REAL, timestamp TEXT, received TEXT);",
    "name": "Buat Tabel",
    "x": 590,
    "y": 40,
    "wires": [
      []
    ]
  },
  {
    "id": "mqtt_sensor_in",
    "type": "mqtt in",
    "z": "flow_api",
    "name": "Subscribe Sensor",
    "topic": "iot/sensor",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_config",
    "x": 160,
    "y": 120,
    "wires": [
      [
        "proses"
      ]
    ]
  },
  {
    "id": "proses",
    "type": "function",
    "z": "flow_api",
    "name": "Proses Sensor",
    "func": "const d = msg.payload;\nd.received = new Date().toISOString();\nflow.set('lastSensor', d);\nconst th = flow.get('threshold');\nconst dbMsg = {params: {$suhu: d.suhu, $kelembaban: d.kelembaban, $timestamp: d.timestamp, $received: d.received}};\nconst wsMsg = {payload: {type: 'sensor', data: d, threshold: th}};\nlet alertMsg = null;\nconst now = Date.now();\nif (d.suhu > th && now - (flow.get('lastAlert') || 0) > 10000) {\n  flow.set('lastAlert', now);\n  alertMsg = {topic: 'iot/notifikasi', payload: {type: 'alert', message: 'Suhu ' + d.suhu + ' C melewati batas ' + th + ' C', suhu: d.suhu, threshold: th, time: d.received}};\n}\nreturn [dbMsg, wsMsg, alertMsg];",
    "outputs": 3,
    "noerr": 0,
    "x": 400,
    "y": 120,
    "wires": [
      [
        "sql_insert"
      ],
      [
        "ws_out",
        "debug_sensor"
      ],
      [
        "ws_out",
        "debug_alert",
        "mqtt_out"
      ]
    ]
  },
  {
    "id": "sql_insert",
    "type": "sqlite",
    "z": "flow_api",
    "mydb": "sqlite_db",
    "sqlquery": "prepared",
    "sql": "INSERT INTO sensor_history (suhu,kelembaban,timestamp,received) VALUES ($suhu,$kelembaban,$timestamp,$received);",
    "name": "Simpan ke SQLite",
    "x": 680,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "debug_sensor",
    "type": "debug",
    "z": "flow_api",
    "name": "Log Sensor",
    "active": true,
    "complete": "payload",
    "x": 680,
    "y": 140,
    "wires": []
  },
  {
    "id": "debug_alert",
    "type": "debug",
    "z": "flow_api",
    "name": "Log Notifikasi",
    "active": true,
    "complete": "payload",
    "x": 690,
    "y": 200,
    "wires": []
  },
  {
    "id": "ws_out",
    "type": "websocket out",
    "z": "flow_api",
    "name": "WebSocket Broadcast",
    "server": "ws_listener",
    "client": "",
    "x": 920,
    "y": 140,
    "wires": []
  },
  {
    "id": "mqtt_out",
