  {
    "id": "cors_fn",
    "type": "function",
    "z": "flow_api",
    "name": "CORS Headers",
    "func": "msg.statusCode = 204;\nmsg.payload = '';\nmsg.headers = {\n 'Access-Control-Allow-Origin': '*',\n 'Access-Control-Allow-Methods': 'GET, POST, PUT, OPTIONS',\n 'Access-Control-Allow-Headers': 'Content-Type, X-API-Key'\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 400,
    "y": 560,
    "wires": [
      [
        "http_resp"
      ]
    ]
  }
]